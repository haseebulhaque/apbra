# Local-only placeholders. Generate fresh values; never commit actual secrets.
APBRA_PROFILE=development
APBRA_DATABASE_URL=postgresql+psycopg://apbra:change-me@127.0.0.1:54321/apbra
APBRA_PUBLIC_ORIGIN=http://127.0.0.1:5173
APBRA_API_ORIGIN=http://127.0.0.1:8000
APBRA_SESSION_SECRET=generate-a-random-local-value-at-least-32-characters
APBRA_BOOTSTRAP_ENABLED=true
APBRA_INVITATION_TTL_DAYS=7
# Development/test always require one exact authorization-response iss value.
APBRA_OIDC_RESPONSE_ISSUER_POLICY=required
APBRA_OIDC_AUTHORIZATION_RESPONSE_ISS_PARAMETER_SUPPORTED=true
