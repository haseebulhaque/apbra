# Local-only placeholders. Generate fresh values; never commit actual secrets.
APBRA_PROFILE=development
APBRA_DATABASE_URL=postgresql+psycopg://apbra:change-me@127.0.0.1:54321/apbra
APBRA_PUBLIC_ORIGIN=http://127.0.0.1:5173
APBRA_API_ORIGIN=http://127.0.0.1:8000
APBRA_SESSION_SECRET=generate-a-random-local-value-at-least-32-characters
APBRA_BOOTSTRAP_ENABLED=true
APBRA_INVITATION_TTL_DAYS=7
APBRA_EVIDENCE_ROOT=/var/lib/apbra/evidence
APBRA_REFERENCE_ROOT=/var/lib/apbra/references
APBRA_ARTIFACT_ROOT=/var/lib/apbra/artifacts
APBRA_SEMANTIC_BRIDGE_PATH=/app/runtime/apbra-semantic-bridge.mjs
APBRA_GENERATION_BRIDGE_PATH=/app/runtime/apbra-generation-bridge.mjs
APBRA_SEMANTIC_NODE_PATH=/usr/local/bin/node
APBRA_SEMANTIC_TIMEOUT_SECONDS=30
APBRA_GENERATION_TIMEOUT_SECONDS=60
APBRA_UPLOAD_POLICY_JSON={"data_extensions":["CSV","XLSX"],"reference_extensions":["PNG","JPG","JPEG"],"max_file_bytes":5000000,"max_files_per_selection":8,"max_data_items_per_report":20,"max_reference_items_per_report":20}
APBRA_CLARIFICATION_POLICY_JSON={"max_rounds":3,"max_questions_per_round":5,"max_answer_characters":2000}
APBRA_GENERATION_POLICY_JSON={"organisation":{"name":"APBRA local","displayName":"APBRA local","locale":"en-AU","timezone":"Australia/Sydney"},"branding":{"primary":"#17635E","accent":"#2D7D9A","reportNaming":"Concise business report titles","pageNaming":"Short page names","executiveConvention":"Accessible summaries","themeName":"APBRA local"},"generation":{"enabled":true,"supportedCapabilities":["KPI cards","Bar and column charts","Line charts","Tables","Slicers","Multiple pages","Explicit measures"],"supportedTrendGrains":["DAY","MONTH","QUARTER","YEAR"],"validationRequired":true,"policy":"Local governed candidate generation"},"governance":{"requireKnowledge":true,"requireAccessibility":true,"requireValidation":true,"maxVisualsPerPage":6,"maxPages":5,"humanReviewAtVisuals":6}}
# Disabled by default: enabling a model may create external-provider cost and requires
# an explicitly qualified endpoint/profile plus a server-side credential.
APBRA_AUTOMATIC_GENERATION_ENABLED=false
# Test harnesses may opt in explicitly. This is rejected outside APBRA_PROFILE=test.
APBRA_TEST_SEMANTIC_SIMULATOR_ENABLED=false
# APBRA_MODEL_PROVIDER_PROFILE_JSON={"profile_id":"qualified-profile-id","protocol":"OPENAI_CHAT_COMPATIBLE","endpoint":"https://qualified.example/v1/chat/completions","model_or_deployment":"qualified-model","api_version":"qualified-api-version","region":"qualified-region","prompt_version":"apbra-requirements-v1","configuration_id":"accepted-config-id","capabilities":{"structured_output":true,"vision":false},"max_calls_per_operation":2,"max_input_characters":200000,"max_output_tokens":8000,"time_budget_seconds":60,"request_timeout_seconds":30,"retry_limit":1}
# APBRA_QUALIFIED_PROVIDER_PROFILES_JSON=[<deployment-approved ProviderProfile objects; no implicit entries>]
# APBRA_MODEL_PROVIDER_API_KEY=set-outside-source-control
# When configuring a tenant provider, supply a deployment-owned 256-bit AES-GCM
# keyring outside source control. Example SHAPE only, not a usable key:
# APBRA_TENANT_SECRET_KEYRING_JSON={"active_version":"key-version","keys":{"key-version":"base64-encoded-32-random-bytes"}}
# Retain older key versions until all protected tenant references are rotated.
# Provider profile/key above are one-time development/test seed inputs, not
# normal runtime tenant policy. Existing tenant settings are read from the DB.
# Development/test always require one exact authorization-response iss value.
APBRA_OIDC_RESPONSE_ISSUER_POLICY=required
APBRA_OIDC_AUTHORIZATION_RESPONSE_ISS_PARAMETER_SUPPORTED=true
