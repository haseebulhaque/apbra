      "filter_direction": "dimension-to-fact",
      "active": true
    }
  ],
  "date_table": "DimDate",
  "date_column": "Date",
  "measures": [
    {
      "id": "total-sales",
      "name": "Total Sales",
      "meaning": "Sum net SalesAmount in current filter context",
      "expression_intent": "SUM(FactSales.SalesAmount)",
      "format": "AUD 0.00"
    },
    {
      "id": "total-orders",
      "name": "Total Orders",
      "meaning": "Distinct OrderId in current filter context, not sales-line count",
      "expression_intent": "DISTINCTCOUNT(FactSales.OrderId)",
      "format": "integer"
    },
    {
      "id": "average-order-value",
      "name": "Average Order Value",
      "meaning": "Total Sales divided by Total Orders; blank for zero denominator",
      "expression_intent": "DIVIDE(Total Sales, Total Orders, BLANK)",
      "format": "AUD 0.00"
    },
    {
      "id": "sales-previous-year",
      "name": "Sales Previous Year",
      "meaning": "Sales in equivalent prior-calendar-year date context; blank outside supplied coverage",
      "expression_intent": "shift DimDate.Date context back one calendar year",
      "format": "AUD 0.00"
    },
    {
      "id": "sales-yoy-change",
      "name": "Sales YoY Change",
      "meaning": "Total Sales minus Sales Previous Year; blank if comparison unavailable",
      "expression_intent": "Total Sales - Sales Previous Year",
      "format": "AUD 0.00"
    },
    {
      "id": "sales-yoy-percent",
      "name": "Sales YoY %",
      "meaning": "Sales YoY Change divided by Sales Previous Year; blank for unavailable or zero denominator",
      "expression_intent": "DIVIDE(Sales YoY Change, Sales Previous Year, BLANK)",
      "format": "0.00%"
    }
  ],
  "pages": [
    {
      "id": "executive-summary",
      "name": "Executive Summary",
      "visual_intents": [
        {
          "kind": "kpi-cards",
          "measures": [
