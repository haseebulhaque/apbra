    },
    {
      "from_table": "FactSales",
      "from_column": "BusinessAreaId",
      "to_table": "DimBusinessArea",
      "to_column": "BusinessAreaId",
      "cardinality": "many-to-one",
      "filter_direction": "dimension-to-fact",
      "active": true
    },
    {
